# PostgreSQL (required in production — use Neon, Supabase, Vercel Postgres, or Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js / NextAuth (required in production)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://your-domain.vercel.app"

# Legacy aliases (optional; Auth.js also reads these)
NEXTAUTH_SECRET="same-as-AUTH_SECRET"
NEXTAUTH_URL="same-as-AUTH_URL"

# Optional: Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: protect /api/jobs/run and /api/admin/jobs
JOB_RUNNER_SECRET="change-me-in-production"

# Local dogfood only — never enable on public hosts
DOGFOOD_AUTO_LOGIN="false"
DOGFOOD_EMAIL="user@project365.local"
